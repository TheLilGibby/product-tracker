FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
DATABASE_URI=sqlite:///product_tracker.db
# Set to 1 to enable debug mode
DEBUG=1
# 2captcha API key for solving CAPTCHAs (required for Newegg scraping)
TWOCAPTCHA_API_KEY=your-2captcha-api-key-here 
# Telegram alerts (optional). Bot token from @BotFather; chat id of the channel/group/user
# the bot should post to (e.g. -1001234567890 for a channel).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only ONE running tracker may post to Telegram. Set this to 0 in the environment of
# every other process that loads the app (a second dev server, a preview, a check
# script) or the channel fills with the same alerts from several databases at once.
TELEGRAM_ALERTS_ENABLED=1
# Only ONE running tracker may run the background scheduler, for a sharper reason:
# the auto-cart job fires real cart attempts at retailers, so a second instance is a
# duplicate auto-carter. With this at 0 no scheduler is created at all - no check,
# auto-cart or snapshot job - while the database and the UI stay fully live, and
# the manual Update Now buttons still work. Every instance that is not the
# designated one sets both: SCHEDULER_ENABLED=0 TELEGRAM_ALERTS_ENABLED=0
SCHEDULER_ENABLED=1
# Short name prefixed to every Telegram post, so you can tell which instance sent it
INSTANCE_LABEL=
# Password for the dashboard (HTTP Basic, any username). Blank = no login, fine on localhost.
# REQUIRED before exposing the app through a tunnel: the UI can add/delete products, trigger
# cart attempts and rewrite this file. While it is blank, the public link is left out of Telegram.
DASHBOARD_PASSWORD=
# Public URL of the dashboard (e.g. the Cloudflare tunnel URL) - used for links in Telegram messages
PUBLIC_URL=
# Post a dashboard screenshot to Telegram every N minutes (0 = off; use the /telegram page button on demand)
SNAPSHOT_INTERVAL_MINUTES=0

# How often each store may be checked, in minutes: "gamestop=60,bestbuy=15" or
# the equivalent JSON. Any store not listed is checked every cycle.
STORE_CHECK_INTERVALS=
# Consecutive failed scrapes before a store's products are skipped for a while
STORE_BACKOFF_FAILURES=2
# How long that first skip lasts, doubling with each further failure
STORE_BACKOFF_MINUTES=15
# Ceiling for that doubling
STORE_BACKOFF_MAX_MINUTES=60
# How long to wait before trying to auto-cart the same product again
AUTO_CART_COOLDOWN_MINUTES=30
# Shared secret for the JSON API and the MCP server. Leave blank to leave the API
# open (fine for localhost); if set, the MCP server needs the same value.
API_TOKEN=
# Where the MCP server should reach the Flask app (keep this on localhost even
# when a Cloudflare tunnel is up — the tunnel URL is slower and changes)
PRODUCT_TRACKER_URL=http://localhost:5000
# Public Cloudflare quick-tunnel URL (informational; shown on Settings)
PRODUCT_TRACKER_PUBLIC_URL=
# Amazon add-to-cart (optional): Cookie header from a logged-in amazon.com tab
AMAZON_COOKIES=
