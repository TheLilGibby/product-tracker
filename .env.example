FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
DATABASE_URI=sqlite:///product_tracker.db
# Set to 1 to enable debug mode
DEBUG=1
# 2captcha API key for solving CAPTCHAs (required for Newegg scraping)
TWOCAPTCHA_API_KEY=your-2captcha-api-key-here 

# How often each store may be checked, in minutes: "gamestop=60,bestbuy=15" or
# the equivalent JSON. Any store not listed is checked every cycle.
STORE_CHECK_INTERVALS=
# Consecutive failed scrapes before a store's products are skipped for a while
STORE_BACKOFF_FAILURES=2
# How long that first skip lasts, doubling with each further failure
STORE_BACKOFF_MINUTES=15
# Ceiling for that doubling
STORE_BACKOFF_MAX_MINUTES=60
# How long to wait before trying to auto-cart the same product again
AUTO_CART_COOLDOWN_MINUTES=30
